<?xml version="1.0" encoding="utf-8"?>
<!-- Un widget de l'écran d'accueil : l'image dessinée par l'appli, centrée. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_racine"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:contentDescription="@string/app_widget_image"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/widget_attente"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_fond"
        android:gravity="center"
        android:padding="16dp"
        android:text="@string/app_widget_attente"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp"
        android:visibility="gone" />
</FrameLayout>
